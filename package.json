{
  "name": "between-sessions",
  "version": "0.1.0",
  "private": true,
  "description": "A companion for recurring 1:1 sessions built on Bee wearable data",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "aws:deploy": "cdk deploy BetweenSessions",
    "aws:seed": "tsx scripts/seed-series.ts --store dynamo",
    "aws:claude": "tsx scripts/claude-session.ts --real",
    "aws:brief": "tsx scripts/brief.ts",
    "aws:review": "tsx src/local/review-ui.ts --store dynamo",
    "aws:watch": "tsx scripts/watch.ts --store dynamo",
    "aws:check": "tsx scripts/check-remote.ts",
    "aws:guardrails-restore": "tsx scripts/guardrails-restore.ts",
    "local:collect": "tsx scripts/collect.ts",
    "local:mcp": "tsx src/local/mcp-http.ts",
    "local:check": "tsx scripts/check-mcp.ts",
    "local:show": "tsx scripts/check-mcp.ts --full",
    "local:review": "tsx src/local/review-ui.ts --store file",
    "local:watch": "tsx scripts/watch.ts --store file",
    "demo:seed": "tsx scripts/demo-seed.ts",
    "demo:claude": "tsx scripts/claude-session.ts",
    "demo:mcp": "STORE_FILE=snapshots/demo-store.json tsx src/local/mcp-http.ts",
    "demo:review": "STORE_FILE=snapshots/demo-store.json BEE_BIN=test/fixtures/fake-bee.mjs BEE_DAYS=60 tsx src/local/review-ui.ts --store file",
    "demo:watch": "STORE_FILE=snapshots/demo-store.json BEE_BIN=test/fixtures/fake-bee.mjs tsx scripts/watch.ts --store file",
    "demo:notes": "tsx scripts/try-notes.ts",
    "demo:alexa": "STORE_FILE=snapshots/demo-store.json tsx scripts/alexa-demo.ts",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "cdk": "cdk"
  },
  "packageManager": "yarn@4.18.1+sha512.b2e1e7524f654f2749d32b4ebcb4622473cb5bcbc485df2007e12a154e50162a4d795526768bc5f5b8f81717bfd79deb2472813d86fb5ae2eb551fa9c872b08f",
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1153.0",
    "@aws-sdk/client-dynamodb": "^3.1153.0",
    "@aws-sdk/client-lambda": "^3.1153.0",
    "@aws-sdk/client-secrets-manager": "^3.1153.0",
    "@aws-sdk/client-sns": "^3.1153.0",
    "@aws-sdk/lib-dynamodb": "^3.1153.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@beeai/cli": "0.8.0",
    "@types/node": "^22",
    "ask-sdk-model": "^1.86.0",
    "aws-cdk": "^2.1146.0",
    "aws-cdk-lib": "^2.273.0",
    "constructs": "^10.8.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}

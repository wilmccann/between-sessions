# Copy to .env (git-ignored). Never commit real values.
# Bearer token for the local MCP server; generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MCP_TOKEN=
MCP_PORT=8788
# Optional: path to your series file (defaults to series.local.json, then series.example.json)
# SERIES_FILE=series.local.json
